# PostgreSQL
DB_USER=bside_admin
DB_PASSWORD=change-me
DB_NAME=bside_db
DB_PORT=5432
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}

# Backend authentication and internal API access
JWT_SECRET=change-me
# Generate a random value of at least 32 characters (for example: openssl rand -hex 32).
PUBLIC_API_KEY=replace-with-at-least-32-random-characters

# Initial administrator (created only when it does not already exist)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=BSideAdmin
ADMIN_PASSWORD=change-me

# Google OAuth 2.0
OAUTH_ID=your-google-client-id
OAUTH_PW=your-google-client-secret
G_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
G_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_URL=https://localhost/api/auth/google/callback

# S3-compatible object storage / MinIO
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:9000
AWS_PUBLIC_ENDPOINT_URL=https://localhost

# Application URLs
FRONTEND_URL=https://localhost
PORT=8080

# Contact-form email delivery
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me
